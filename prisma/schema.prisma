generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



model User {

 id String @id @default(cuid())

 name String

 email String @unique

 avatar String?

 level String @default("HSK1")

 xp Int @default(0)

 streak Int @default(0)

 createdAt DateTime @default(now())


 favorites Favorite[]

 exams Exam[]

 posts Post[]

}




model Favorite {

 id String @id @default(cuid())

 word String

 meaning String

 userId String

 user User @relation(
 fields:[userId],
 references:[id]
 )

}



model Exam {

 id String @id @default(cuid())

 name String

 score Int

 userId String

 user User @relation(
 fields:[userId],
 references:[id]
 )

}

model Word {

 id String @id @default(cuid())

 hanzi String

 pinyin String

 zhuyin String?

 meaning String

 example String?

 level String

 type String

 createdAt DateTime @default(now())

}


model Video {

 id String @id @default(cuid())

 title String

 url String

 level String

 description String?

}


model Question {

 id String @id @default(cuid())

 question String

 answer String

 options String

 level String

}


model Post {

 id String @id @default(cuid())

 content String

 likes Int @default(0)

 userId String

 user User @relation(
 fields:[userId],
 references:[id]
 )

}
